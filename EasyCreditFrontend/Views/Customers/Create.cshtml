@model CustomerFormViewModel
@{
    ViewData["Title"] = "Tambah Customer";
}

<div class="page-head">
    <div>
        <div class="crumbs">
            <a asp-controller="Home" asp-action="Index">Dashboard</a>
            <span>/</span>
            <a asp-action="Index">Customer</a>
            <span>/</span>
            <span>Tambah</span>
        </div>
        <h2>Tambah customer</h2>
        <p>Form ini memakai Razor tag helper dan Data Annotation validation.</p>
    </div>
</div>

<div class="panel form-panel">
    <form asp-action="Create" method="post">
        <partial name="_CustomerForm" model="Model" />

        <div class="form-actions">
            <a class="btn btn-light" asp-action="Index">Batal</a>
            <button type="submit" class="btn btn-accent">Simpan customer</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
