@model EasyCreditFrontend.Models.Dtos.CreditApplicationDetailDto
@{
    ViewData["Title"] = $"Detail Pengajuan #{Model.ApplicationId}";
    var statusClass = Model.Status?.ToUpperInvariant() switch
    {
        "APPROVED" => "is-approved",
        "REJECTED" => "is-rejected",
        _ => "is-pending"
    };

    var culture = new System.Globalization.CultureInfo("id-ID");
}

<div class="page-head">
    <div>
        <div class="crumbs">
            <a asp-controller="Home" asp-action="Index">Dashboard</a>
            <span>/</span>
            <a asp-action="Index">Pengajuan</a>
            <span>/</span>
            <span>Detail #@Model.ApplicationId</span>
        </div>
        <div class="d-flex align-items-center gap-3 mt-1">
            <h2 class="mb-0">Pengajuan Kredit #@Model.ApplicationId</h2>
            <span class="badge-status @statusClass">@Model.Status</span>
        </div>
        <p class="mt-1">Rincian data pengajuan transaksi, identitas nasabah, dan jadwal cicilan.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @if (ViewBag.IsAdmin == true && (Model.Status == "PENDING" || Model.Status == "SUBMITTED"))
        {
            <div id="approvalActions" class="d-flex gap-2">
                <button type="button" class="btn btn-danger-soft js-detail-action" data-action="Reject" data-id="@Model.ApplicationId">
                    ✕ Tolak (Reject)
                </button>
                <button type="button" class="btn btn-accent js-detail-action" data-action="Approve" data-id="@Model.ApplicationId">
                    ✓ Setujui (Approve)
                </button>
            </div>
        }
        <a class="btn btn-light" asp-action="Index">← Kembali ke Daftar</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Kolom Kiri: Informasi Pengajuan -->
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-head">
                <div>
                    <h3>Data Transaksi Kredit</h3>
                    <p>Informasi permohonan pinjaman dan status persetujuan</p>
                </div>
            </div>
            <div class="p-4">
                <dl class="row mb-0 gy-3" style="font-size: 13.5px;">
                    <dt class="col-sm-5 text-dim">Nominal Pinjaman</dt>
                    <dd class="col-sm-7 mono cell-strong fs-6">
                        @Model.Amount.ToString("C0", culture)
                    </dd>

                    <dt class="col-sm-5 text-dim">Jangka Waktu (Tenor)</dt>
                    <dd class="col-sm-7 cell-strong">
                        @Model.TenorMonths Bulan (@Model.Installments.Count kali cicilan)
                    </dd>

                    <dt class="col-sm-5 text-dim">Suku Bunga</dt>
                    <dd class="col-sm-7">
                        @(Model.InterestRate * 100)% flat / bulan
                    </dd>

                    <dt class="col-sm-5 text-dim">Skor Kredit Internal</dt>
                    <dd class="col-sm-7 mono">
                        @Model.CreditScore
                    </dd>

                    <dt class="col-sm-5 text-dim">Status Pengajuan</dt>
                    <dd class="col-sm-7">
                        <span id="detailStatusBadge" class="badge-status @statusClass">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-5 text-dim">Disetujui Oleh</dt>
                    <dd id="detailApprovedBy" class="col-sm-7 text-dim">
                        @(string.IsNullOrWhiteSpace(Model.ApprovedBy) ? "— (Menunggu persetujuan admin)" : Model.ApprovedBy)
                    </dd>

                    <dt class="col-sm-5 text-dim">Waktu Persetujuan</dt>
                    <dd id="detailApprovedAt" class="col-sm-7 text-dim">
                        @(Model.ApprovedAt.HasValue ? Model.ApprovedAt.Value.ToString("dd MMMM yyyy HH:mm", culture) : "—")
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Kolom Kanan: Profil Nasabah -->
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-head">
                <div>
                    <h3>Data Nasabah (Debitur)</h3>
                    <p>Informasi identitas dan kontak pemohon kredit</p>
                </div>
                @if (Model.Customer != null)
                {
                    if (Model.Customer.IsDeleted)
                    {
                        <span class="badge-status is-rejected">
                            Nasabah Non-Aktif
                        </span>
                    }
                    else
                    {
                        <span class="status-pill">
                            <span class="status-dot"></span>
                            Terverifikasi
                        </span>
                    }
                }
            </div>
            <div class="p-4">
                @if (Model.Customer == null)
                {
                    <div class="text-center py-4 text-dim">
                        <p>Data profil nasabah tidak ditemukan atau telah dihapus.</p>
                    </div>
                }
                else
                {
                    <dl class="row mb-0 gy-3" style="font-size: 13.5px;">
                        <dt class="col-sm-4 text-dim">ID Nasabah</dt>
                        <dd class="col-sm-8 mono cell-strong">#@Model.Customer.CustomerId</dd>

                        <dt class="col-sm-4 text-dim">Nama Lengkap</dt>
                        <dd class="col-sm-8 cell-strong">@Model.Customer.Name</dd>

                        <dt class="col-sm-4 text-dim">Nomor KTP (NIK)</dt>
                        <dd class="col-sm-8 mono">@Model.Customer.Nik</dd>

                        <dt class="col-sm-4 text-dim">Nomor Telepon</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Customer.Phone) ? "—" : Model.Customer.Phone)</dd>

                        <dt class="col-sm-4 text-dim">Alamat Email</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Customer.Email) ? "—" : Model.Customer.Email)</dd>

                        <dt class="col-sm-4 text-dim">Alamat Lengkap</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Customer.Address) ? "—" : Model.Customer.Address)</dd>
                    </dl>
                }
            </div>
        </div>
    </div>
</div>

<!-- Panel Bawah: Tabel Jadwal Cicilan Lengkap -->
<div class="panel">
    <div class="panel-head">
        <div>
            <h3>Jadwal & Rincian Angsuran Cicilan</h3>
            <p>Jadwal dan rincian nominal pembayaran per periode</p>
        </div>
        <span class="status-pill">
            Total @Model.Installments.Count Angsuran
        </span>
    </div>

    @if (!Model.Installments.Any())
    {
        <div class="p-5 text-center text-dim">
            <p class="mb-0">Belum ada baris cicilan yang tercatat untuk pengajuan ini.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 15%">Angsuran Ke-</th>
                        <th style="width: 35%">Tanggal Jatuh Tempo</th>
                        <th style="width: 30%">Jumlah Angsuran</th>
                        <th style="width: 20%">Status Pembayaran</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inst in Model.Installments)
                    {
                        var instClass = string.Equals(inst.Status, "PAID", StringComparison.OrdinalIgnoreCase)
                            ? "is-approved"
                            : "is-pending";

                        <tr>
                            <td class="cell-strong mono">Cicilan #@inst.InstallmentNo</td>
                            <td>
                                @inst.DueDate.ToString("dd MMMM yyyy", culture)
                            </td>
                            <td class="mono cell-strong">
                                @inst.InstallmentAmount.ToString("C0", culture)
                            </td>
                            <td>
                                <span class="badge-status @instClass">@inst.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="panel-foot">
            <span class="text-dim">
                Bunga: <strong>@(Model.InterestRate * 100)% flat / bulan</strong>
            </span>
            <span class="cell-strong">
                Total Kewajiban Pembayaran:
                @Model.Installments.Sum(i => i.InstallmentAmount).ToString("C0", culture)
            </span>
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        $(function () {
            var token = $('input[name="__RequestVerificationToken"]').val();

            $('.js-detail-action').on('click', async function () {
                var action = $(this).data('action'); // "Approve" atau "Reject"
                var appId = $(this).data('id');
                var label = action === 'Approve' ? 'menyetujui' : 'menolak';

                var ok = await EC.confirm({
                    title: (action === 'Approve' ? 'Approve' : 'Reject') + ' Pengajuan?',
                    message: 'Apakah Anda yakin ingin ' + label + ' pengajuan kredit #' + appId + '?',
                    confirmText: 'Ya, ' + (action === 'Approve' ? 'Approve' : 'Reject'),
                    danger: action !== 'Approve'
                });

                if (!ok) return;

                var url = action === 'Approve'
                    ? '@Url.Action("Approve", "CreditApplications")/' + appId
                    : '@Url.Action("Reject", "CreditApplications")/' + appId;

                var $btn = $(this);
                $btn.prop('disabled', true);

                $.ajax({
                    url: url,
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    success: function (res) {
                        EC.toast('success', res.message || 'Pengajuan kredit berhasil diproses.', 'Berhasil');
                        var newStatus = action === 'Approve' ? 'APPROVED' : 'REJECTED';
                        var badgeClass = action === 'Approve' ? 'is-approved' : 'is-rejected';

                        // Update DOM real-time
                        $('#detailStatusBadge, .page-head .badge-status')
                            .removeClass('is-pending is-approved is-rejected')
                            .addClass(badgeClass)
                            .text(newStatus);

                        $('#detailApprovedBy').removeClass('text-dim').addClass('cell-strong').text(res.approver || 'Administrator');
                        $('#approvalActions').fadeOut();
                    },
                    error: function (xhr) {
                        $btn.prop('disabled', false);
                        var msg = (xhr.responseJSON && xhr.responseJSON.message)
                            ? xhr.responseJSON.message
                            : 'Gagal memproses pengajuan kredit.';
                        EC.toast('error', msg, 'Gagal');
                    }
                });
            });
        });
    </script>
}

